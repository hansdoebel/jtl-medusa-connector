# The connector token is entered in JTL-Wawi. Generate a new random token.
JTL_TOKEN=
MEDUSA_ADMIN_URL=https://medusa.example.com
# Medusa secret API key, never a storefront publishable key.
MEDUSA_ADMIN_API_KEY=
MEDUSA_VERSION=2
MEDUSA_SHIPPING_PROFILE_ID=
# Configure the Medusa region for tax-exclusive prices before synchronizing.
SHOP_CURRENCY=eur
SHOP_LANGUAGE=de

{
  "name": "integration/jtl-medusa-connector",
  "description": "JTL-Connector endpoint for a Medusa v2 catalog integration",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-pdo_sqlite": "*",
    "jtl/connector": "6.0.1",
    "guzzlehttp/guzzle": "^7.10"
  },
  "require-dev": { "phpunit/phpunit": "^11.5" },
  "autoload": { "psr-4": { "JtlMedusa\\": "src/" } },
  "autoload-dev": { "psr-4": { "JtlMedusa\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit --testdox" },
  "config": { "sort-packages": true, "allow-plugins": false }
}
